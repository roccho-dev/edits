#!/bin/sh
set -eu
provider=${EDITS_VIM_BIN:-/bin/vim}
case "$provider" in
  /*) ;;
  *) echo "edits-client: exact Vim provider path must be absolute: $provider" >&2; exit 64 ;;
esac
[ -x "$provider" ] || { echo "edits-client: exact Vim provider is not executable: $provider" >&2; exit 69; }
exec "$provider" "$@"
