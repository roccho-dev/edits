#!/bin/sh
set -eu
provider=${EDITS_HQ_BIN:-/bin/hq}
case "$provider" in
  /*) ;;
  *) echo "edits-service: exact HQ provider path must be absolute: $provider" >&2; exit 64 ;;
esac
[ -x "$provider" ] || { echo "edits-service: exact HQ provider is not executable: $provider" >&2; exit 69; }
exec "$provider" "$@"
