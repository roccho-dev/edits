{"id":"operation.apply","rel":{"parent":"package.vim","kind":"contains"},"kind":"operation","sources":[],"content":{"responsibility":"CompleteDone consumes b:surface_done saved at CompleteDonePre; never calls Complete directly. Compose old prefix + entire multiline selected word + old suffix; require preserved outer lines and cursor suffix. On mismatch restore only owned insertion when possible and keep unrelated edits; no record. Otherwise set lines/cursor and store {handle,base,label,provenance,info} as historical selection even after Undo or later Working; not Accepted.","bindings":[{"source":{"repository":"roccho-dev/edits","revision":"b2f068be67be43a5f4507909a37deacf31068f56","path":"packages/vim/surface.vim","gitBlob":"3cfffbe8cebab65f4353337eb05f3fb6a7703079","url":null,"bodyDigest":null,"selector":"def Apply()"},"symbol":"def Apply()","description":"Exact source operation."}],"requiredIds":["required.selection","required.current-behavior"],"providedIds":["provided.native"],"input":{"state":"KNOWN","description":"Saved {item,base}, current cursor/Working/suffix and outer rows.","conditions":[],"sources":[],"findingIds":[]},"output":{"state":"KNOWN","description":"Exact representation with suffix and unadopted choice-time origin.","conditions":[],"sources":[],"findingIds":[]},"error":{"state":"KNOWN","description":"Stale external edits reject/restore own insertion without recording.","conditions":[],"sources":[],"findingIds":[]},"effect":{"state":"KNOWN","description":"setline/deletebufline/cursor/selection/echo; not Commit or Admit.","conditions":[],"sources":[],"findingIds":[]},"dependencies":[{"targetId":"operation.capture","external":null,"port":null,"condition":"Reads saved b:surface_done through native events; not a direct call","purpose":"Native state/data handoff","state":"KNOWN","findingIds":[]}],"findingIds":["finding.observation"]}}
