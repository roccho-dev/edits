{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roccho.dev/edits/edit-plan.v1.schema.json",
  "title": "edits.editPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "document_version", "edits"],
  "properties": {
    "kind": {"const": "edits.editPlan.v1"},
    "document_version": {"type": "integer", "minimum": 0},
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text"],
        "properties": {
          "start": {"$ref": "edit-context.v1.schema.json#/$defs/position"},
          "end": {"$ref": "edit-context.v1.schema.json#/$defs/position"},
          "text": {"type": "string"}
        }
      }
    }
  }
}
