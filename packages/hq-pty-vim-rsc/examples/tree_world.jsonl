{"kind":"schema.object","object":"project","description":"root project object that owns n task children"}
{"kind":"schema.key","object":"project","key":"kind","type":"enum","required":true,"enum":["project"],"description":"object discriminator"}
{"kind":"schema.key","object":"project","key":"id","type":"string","required":true,"description":"stable project id"}
{"kind":"schema.key","object":"project","key":"name","type":"string","required":true,"description":"human project name"}
{"kind":"schema.key","object":"project","key":"status","type":"enum","required":false,"enum":["active","paused","archived"],"description":"project status"}
{"kind":"schema.key","object":"project","key":"tasks","type":"array:ref","ref":"task","relation":"contains","required":true,"description":"1 x n child task references"}
{"kind":"schema.object","object":"task","description":"child task object"}
{"kind":"schema.key","object":"task","key":"kind","type":"enum","required":true,"enum":["task"],"description":"object discriminator"}
{"kind":"schema.key","object":"task","key":"id","type":"string","required":true,"description":"stable task id"}
{"kind":"schema.key","object":"task","key":"title","type":"string","required":true,"description":"task title"}
{"kind":"schema.key","object":"task","key":"owner","type":"enum","required":true,"enum":["me","agent:a","agent:b"],"description":"task owner"}
{"kind":"schema.key","object":"task","key":"priority","type":"enum","required":false,"enum":["low","normal","high"],"description":"task priority"}
{"kind":"schema.key","object":"task","key":"deps","type":"array:ref","ref":"task","relation":"depends_on","required":false,"description":"n x n task dependencies"}
